# VoltTrade Cloud gateway — environment template.
# Copy to `.env` and fill in. NEVER commit real values.
# Every variable read by api/, scripts/ and vite.config.ts is documented here
# (audit P1-3). Placeholders only — no production secrets in this file.

# ── Core / backend ─────────────────────────────────────────────
NODE_ENV=                 # development | production (production enables strict checks; default: development)
PORT=                     # HTTP listen port (default: 3000)
APP_ID=                   # Application ID (required in production)
APP_SECRET=               # Application secret, used for JWT/signing (required in production)
API_TOKEN=                # Optional static bearer token guarding /api/trpc/* (unset = disabled)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string: mysql://user:pass@host:3306/db (required in production)
TIMESCALE_URL=            # Optional TimescaleDB/Postgres URL; when set, telemetry store defaults to "timescale"

# ── Security / auth ────────────────────────────────────────────
AUTH_REQUIRED=            # "false" = open demo mode, skips RBAC + audit (DEV ONLY — refused at boot in production)
ADMIN_EMAIL=              # Seed admin login email (default: admin@enertrek.local)
ADMIN_NAME=               # Seed admin display name (default: Administrator)
ADMIN_PASSWORD=           # Seed admin password (default: admin1234 — CHANGE IT in any real deployment)
ALLOW_UNSAFE_PROD=        # "1" lets destructive scripts run against a remote DB (db-guard escape hatch; default: off)
MFA_ENCRYPTION_KEY=       # 64 hex chars (32 bytes) — encrypts TOTP secrets at rest (audit #23). Fallback: derived from SESSION_SECRET; if neither is set, MFA is unavailable (procedures return a clear error)
SESSION_SECRET=           # Optional session/MFA key-derivation source (see MFA_ENCRYPTION_KEY fallback)

# ── MQTT ───────────────────────────────────────────────────────
MQTT_URL=                 # External broker URL; when set the app is a broker CLIENT, no embedded broker (HA mode)
MQTT_USERNAME=            # Broker username (optional)
MQTT_PASSWORD=            # Broker password (optional)
MQTT_SHARED_SUB=          # "0" disables shared subscriptions when MQTT_URL is set (default: enabled)
MQTT_BIND_HOST=           # Embedded dev broker bind host (default: 0.0.0.0)
MQTT_EMBEDDED_PORT=       # Embedded dev broker plaintext port (default: 1883)
MQTT_TLS=                 # "0" disables TLS on the embedded broker even if cert files exist (default: auto when files exist)
MQTT_TLS_KEY=             # Path to broker TLS private key (default: certs/dev.key)
MQTT_TLS_CERT=            # Path to broker TLS certificate (default: certs/dev.crt)
MQTT_TLS_PORT=            # Embedded broker TLS port (default: 8883)
MQTT_AUTO_PROVISION=      # "1" auto-provisions unknown gateway devices on first publish (default: 1)
SIM_MQTT_URL=             # Simulator-only: broker URL for scripts/simulator.ts (default: mqtt://127.0.0.1:1883)

# ── Telemetry pipeline ─────────────────────────────────────────
TELEMETRY_STORE=          # mysql | timescale (default: timescale when TIMESCALE_URL set, else mysql)
TELEMETRY_BATCH_MAX=      # Max rows per batch insert (default: 1000)
TELEMETRY_QUEUE_MAX=      # Max queued rows before backpressure/drop (default: 50000)
TELEMETRY_FLUSH_MS=       # Batch flush interval, ms (default: 1000)
TELEMETRY_DRAIN_MS=       # Shutdown drain timeout, ms (default: 10000)
TELEMETRY_RETRY_MAX=      # Batch write retries before giving up (default: 5)
TELEMETRY_WAL_DIR=        # Write-ahead-log dir for crash recovery (default: ./data/wal; "" disables WAL)
TELEMETRY_RAW_DAYS=       # Raw telemetry retention days before purge (default: 90)
ROLLUP_INTERVAL_MIN=      # Downsampling/rollup run interval, minutes (default: 10)

# ── Poller (Modbus TCP) ────────────────────────────────────────
POLLER_ENABLED=           # "0" disables the direct-connect device poller (default: enabled)

# ── EMS (BESS control) ─────────────────────────────────────────
EMS_TICK_S=               # EMS controller tick interval, seconds (default: 30)

# ── Alarms ─────────────────────────────────────────────────────
ALARM_ESCALATE_MIN=       # Minutes before an unacknowledged alarm escalates (default: 15)

# ── Reports / email ────────────────────────────────────────────
REPORT_OUT_DIR=           # Generated report output dir (default: ./data/reports)
REPORT_TICK_MIN=          # Scheduled-report loop interval, minutes (default: 5)
EMAIL_TRANSPORT=          # "log" prints emails to stdout instead of sending (default: SMTP)
SMTP_URL=                 # Full SMTP URL (takes precedence over SMTP_HOST/... if set)
SMTP_HOST=                # SMTP relay host
SMTP_PORT=                # SMTP relay port (default: 587)
SMTP_USER=                # SMTP auth user (optional)
SMTP_PASS=                # SMTP auth password (optional)
SMTP_FROM=                # From: address for outgoing mail (default: volttrade-cloud@localhost)
